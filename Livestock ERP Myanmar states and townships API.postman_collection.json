    {
      "name": "List townships in selected state or region",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Townships belong to selected division', () => { pm.response.to.have.status(200); const rows = pm.response.json().data; pm.expect(rows.length).to.be.above(0); rows.forEach(row => pm.expect(row.division_id).to.eql(Number(pm.variables.get('division_id')))); });",
              "if (pm.response.code === 200 && pm.response.json().data.length) { pm.collectionVariables.set('township', pm.response.json().data[0].name); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
