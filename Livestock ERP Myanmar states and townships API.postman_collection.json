    {
      "name": "List states and regions",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('States and regions returned', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.have.lengthOf(15); });\nif (pm.response.code === 200) { const division = pm.response.json().data.find(row => row.id === 15); pm.collectionVariables.set('division_id', division.id); pm.collectionVariables.set('state_region', division.name); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/setup/divisions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "setup",
            "divisions"
          ]
        }
