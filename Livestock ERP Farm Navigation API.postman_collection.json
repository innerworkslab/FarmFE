        {
          "name": "List Farms",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/farms?branch_id={{branch_id}}&search={{farm_search}}&animal_type={{animal_type}}&farm_type={{farm_type}}&status=active&per_page=15",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "farms"
              ],
              "query": [
                {
                  "key": "branch_id",
                  "value": "{{branch_id}}",
                  "description": "Optional Branch filter."
                },
                {
                  "key": "search",
                  "value": "{{farm_search}}",
                  "description": "Searches farm name, house/barn, pen/cage/pond, or numeric farm id."
                },
                {
                  "key": "animal_type",
                  "value": "{{animal_type}}",
                  "description": "Optional current animal type filter."
                },
                {
                  "key": "farm_type",
                  "value": "{{farm_type}}",
                  "description": "Alias for current animal type until a dedicated farm type field exists."
                },
                {
                  "key": "status",
                  "value": "active",
                  "description": "Only active farms are currently returned."
                },
                {
                  "key": "per_page",
                  "value": "15"
                }
              ]
            },
            "description": "Returns farms authorized for the current user with branch details, generated farm_code, animal count, active batch count, individual animal count, manager, and active status. Supports FARM-US-001 and FARM-US-002."
