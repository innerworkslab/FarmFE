    "name": "Livestock ERP Auth API",
    "description": "Postman collection for the Laravel backend authentication and role/permission authorization endpoints. All API endpoints are versioned under /api/v1. Login uses one login field; the backend resolves it as email or username.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "18564033",
